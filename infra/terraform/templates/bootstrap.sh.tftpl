#!/bin/bash
# =============================================================================
# SideData web server bootstrap (Ubuntu 24.04 LTS arm64).
# Rendered by Terraform (templatefile) and run once by cloud-init at first boot.
#
# Idempotent: safe to re-run at any time as root:
#   sudo /usr/local/sbin/sidedata-bootstrap
# Log: /var/log/sidedata-bootstrap.log
#
# NO SECRETS HERE. Secrets live only in /etc/sidedata/env on the box.
#
# Layout contract with the deploy script:
#   /opt/sidedata/releases/<git-sha>/   Next standalone output (server.js at
#                                       root, .next/static + public merged in)
#   /opt/sidedata/current -> releases/<git-sha>   (atomic symlink switch)
#   /opt/sidedata/shared/                only path the app may write to
#   after switching: systemctl restart sidedata
# =============================================================================
set -euo pipefail

DOMAIN="${domain}"
ACME_EMAIL="${acme_email}"
NODE_MAJOR="${node_major}"
SWAP_MB="${swap_size_mb}"
REBOOT_TIME="${unattended_reboot_time}"

APP_USER=sidedata
APP_ROOT=/opt/sidedata
SELF=/usr/local/sbin/sidedata-bootstrap

exec > >(tee -a /var/log/sidedata-bootstrap.log) 2>&1
echo "=== sidedata bootstrap start $(date -Is) ==="

export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -q -o DPkg::Lock::Timeout=600"

# Keep a copy of this script so it can be re-run later.
if [ "$(readlink -f "$0")" != "$SELF" ]; then
  install -m 0750 -o root -g root "$0" "$SELF"
fi

# --- Base packages -----------------------------------------------------------
$APT update
$APT install ca-certificates curl gnupg unzip unattended-upgrades \
  debian-keyring debian-archive-keyring apt-transport-https

# --- Swap (2 GB RAM box: swap is a safety net, not a build area) -------------
if ! swapon --show=NAME --noheadings | grep -qx /swapfile; then
  if [ ! -f /swapfile ]; then
    fallocate -l "$${SWAP_MB}M" /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
  fi
  swapon /swapfile
fi
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
cat > /etc/sysctl.d/60-sidedata-swap.conf <<'EOF'
vm.swappiness = 10
EOF
sysctl -q --system

# --- journald size limits ----------------------------------------------------
mkdir -p /etc/systemd/journald.conf.d
cat > /etc/systemd/journald.conf.d/60-sidedata.conf <<'EOF'
[Journal]
Storage=persistent
SystemMaxUse=500M
SystemKeepFree=1G
MaxRetentionSec=1month
EOF
systemctl restart systemd-journald

# --- Time sync: keep the image default, just make sure it is on --------------
timedatectl set-ntp true || true

# --- Unattended security upgrades -------------------------------------------
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOF
if [ -n "$REBOOT_TIME" ]; then
  cat > /etc/apt/apt.conf.d/52sidedata-reboot <<EOF
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "$REBOOT_TIME";
EOF
else
  rm -f /etc/apt/apt.conf.d/52sidedata-reboot
fi
# Third-party repos are NOT covered by Ubuntu's default allowed origins.
# These patterns are appended to the defaults. Origin strings were checked with
# `apt-cache policy` and an `unattended-upgrade --dry-run` that upgraded both
# packages on ubuntu:24.04 arm64 (2026-10-24):
#   NodeSource: o=". nodistro", a=nodistro, host deb.nodesource.com
#   Caddy:      o=cloudsmith/caddy/stable, a=any-version, host dl.cloudsmith.io
# Node stays on the pinned major (the repo is node_<major>.x). Caddy's postinst
# restarts Caddy. A Node upgrade takes effect at the next sidedata restart
# (deploy or reboot).
cat > /etc/apt/apt.conf.d/51sidedata-origins <<'EOF'
Unattended-Upgrade::Origins-Pattern {
        "site=deb.nodesource.com,archive=nodistro";
        "site=dl.cloudsmith.io,origin=cloudsmith/caddy/stable";
};
EOF
systemctl enable --now unattended-upgrades.service

# --- SSM Agent (Ubuntu AMIs ship it as a snap) --------------------------------
if snap list amazon-ssm-agent >/dev/null 2>&1; then
  echo "amazon-ssm-agent snap present"
else
  snap install amazon-ssm-agent --classic
fi
snap start --enable amazon-ssm-agent || true

# --- AWS CLI v2 (deploy script runs `aws s3 cp` on the box) -------------------
if ! command -v aws >/dev/null 2>&1 && [ ! -x /snap/bin/aws ]; then
  snap install aws-cli --classic
fi

# --- Node.js (NodeSource apt repo, major pinned) ------------------------------
install -d -m 0755 /usr/share/keyrings
if [ ! -s /usr/share/keyrings/nodesource.gpg ]; then
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor --yes -o /usr/share/keyrings/nodesource.gpg
  chmod 644 /usr/share/keyrings/nodesource.gpg
fi
cat > /etc/apt/sources.list.d/nodesource.sources <<EOF
Types: deb
URIs: https://deb.nodesource.com/node_$${NODE_MAJOR}.x
Suites: nodistro
Components: main
Architectures: $(dpkg --print-architecture)
Signed-By: /usr/share/keyrings/nodesource.gpg
EOF
cat > /etc/apt/preferences.d/nodejs <<'EOF'
Package: nodejs
Pin: origin deb.nodesource.com
Pin-Priority: 600
EOF

# --- Caddy (official apt repo) -----------------------------------------------
if [ ! -s /usr/share/keyrings/caddy-stable-archive-keyring.gpg ]; then
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
    | gpg --dearmor --yes -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
fi
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
  > /etc/apt/sources.list.d/caddy-stable.list
chmod o+r /usr/share/keyrings/caddy-stable-archive-keyring.gpg /etc/apt/sources.list.d/caddy-stable.list

$APT update
$APT install nodejs caddy

INSTALLED_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$INSTALLED_MAJOR" != "$NODE_MAJOR" ]; then
  echo "ERROR: expected Node $NODE_MAJOR, got $(node -v)" >&2
  exit 1
fi
echo "node $(node -v), caddy $(caddy version)"

# --- App user and directories -------------------------------------------------
if ! id "$APP_USER" >/dev/null 2>&1; then
  useradd --system --user-group --home-dir "$APP_ROOT" --no-create-home \
    --shell /usr/sbin/nologin "$APP_USER"
fi
install -d -o root -g root -m 0755 "$APP_ROOT" "$APP_ROOT/releases"
install -d -o "$APP_USER" -g "$APP_USER" -m 0750 "$APP_ROOT/shared"
install -d -o root -g "$APP_USER" -m 0750 /etc/sidedata

# Env file: created once, NEVER overwritten (the owner puts secrets here).
if [ ! -e /etc/sidedata/env ]; then
  cat > /etc/sidedata/env <<'EOF'
# SideData runtime environment for sidedata.service (systemd EnvironmentFile).
# Format: KEY=value, one per line. Quote values with spaces: KEY="a b".
# Edit via SSM Session Manager only. Never commit or put this in Terraform.
# After editing: sudo systemctl restart sidedata
#
# RESEND_API_KEY=
# CONTACT_TO=support@sidedataa.com
# CONTACT_FROM="SideData Website <no-reply@sidedataa.com>"
# TURNSTILE_SECRET_KEY=
#
# NEXT_PUBLIC_* values are inlined at BUILD time (CI), not read from here.
EOF
fi
chown root:"$APP_USER" /etc/sidedata/env
chmod 0640 /etc/sidedata/env

# --- systemd unit for the Next.js server --------------------------------------
cat > /etc/systemd/system/sidedata.service <<'EOF'
[Unit]
Description=SideData Next.js website (standalone server)
After=network-online.target
Wants=network-online.target
# Skipped (not failed) until the first release is deployed.
ConditionPathExists=/opt/sidedata/current/server.js
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sidedata
Group=sidedata
WorkingDirectory=/opt/sidedata/current
EnvironmentFile=/etc/sidedata/env
# NODE_ENV/PORT/HOSTNAME are fixed. systemd lets EnvironmentFile override
# Environment=, so they are set by env(1) at exec time instead, which wins over
# anything in /etc/sidedata/env.
ExecStart=/usr/bin/env NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1 /usr/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=20
UMask=0027

# Hardening. Do NOT add MemoryDenyWriteExecute (breaks the V8 JIT).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The app has no business with instance metadata (role credentials). This is
# per-unit (cgroup BPF); root/SSM/deploy outside this unit are unaffected.
# Amazon DNS (169.254.169.253) stays reachable.
IPAddressDeny=169.254.169.254 fd00:ec2::254
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# The release dir is read-only to the app. If Next needs a writable cache,
# symlink <release>/.next/cache -> /opt/sidedata/shared/next-cache at deploy.
ReadWritePaths=/opt/sidedata/shared

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable sidedata.service
# On re-runs with a release already deployed, make sure it is running.
if [ -e "$APP_ROOT/current/server.js" ]; then
  systemctl start sidedata.service || true
fi

# --- Caddy: automatic HTTPS, www -> apex, reverse proxy -----------------------
# Before DNS points here, ACME fails and Caddy keeps retrying with backoff;
# the service itself stays up. Cert appears minutes after DNS propagates.
export HOME="$${HOME:-/root}" # caddy CLI needs a HOME; cloud-init may not set one
EMAIL_LINE=""
if [ -n "$ACME_EMAIL" ]; then
  EMAIL_LINE="email $ACME_EMAIL"
fi
cat > /etc/caddy/Caddyfile.new <<EOF
# Managed by /usr/local/sbin/sidedata-bootstrap. Local edits are overwritten.
{
	$EMAIL_LINE
	# No HTTP/3: the security group opens TCP 443 only, not UDP 443.
	servers {
		protocols h1 h2
	}
}

www.$DOMAIN {
	redir https://$DOMAIN{uri} permanent
}

$DOMAIN {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000

	# Access log to stderr -> journald (size-limited above).
	# View: journalctl -u caddy
	log {
		output stderr
		format json
	}
}
EOF
caddy fmt --overwrite /etc/caddy/Caddyfile.new
caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile.new
mv /etc/caddy/Caddyfile.new /etc/caddy/Caddyfile
systemctl enable caddy
systemctl reload-or-restart caddy

echo "=== sidedata bootstrap done $(date -Is) ==="
