# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD).
# NEXT_PUBLIC_* values are baked in at BUILD time: set them as GitHub repo variables for deploys.
NEXT_PUBLIC_SITE_URL=https://sidedataa.com

# Email delivery through Resend. If unset: forms log metadata in development
# and return HTTP 503 in production.
RESEND_API_KEY=
# Where inquiries and applications are sent
CONTACT_TO=support@sidedataa.com
# Sender address. Must be on a domain verified in Resend.
CONTACT_FROM="SideData Website <no-reply@sidedataa.com>"

# Cloudflare Turnstile (optional). If TURNSTILE_SECRET_KEY is unset, the
# server skips verification and the widget is not rendered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
